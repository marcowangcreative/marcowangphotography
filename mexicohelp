  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      background: linear-gradient(160deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'DM Sans', 'Helvetica Neue', sans-serif;
      padding: 24px 16px;
      gap: 24px;
    }
    .card {
      width: 100%;
      max-width: 420px;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(40px);
      border-radius: 24px;
      border: 1px solid rgba(255,255,255,0.08);
      padding: 32px 24px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.5);
    }
    .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .header h2 { color: #fff; font-size: 22px; font-weight: 700; letter-spacing: -0.5px; }
    .header .sub { color: rgba(255,255,255,0.35); font-size: 12px; font-family: 'Space Mono', monospace; margin-top: 2px; }
    .btn-refresh {
      background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; color: rgba(255,255,255,0.5); font-size: 11px;
      font-family: 'Space Mono', monospace; padding: 6px 14px; cursor: pointer;
      transition: all 0.2s;
    }
    .btn-refresh:hover { background: rgba(255,255,255,0.1); color: #fff; }
    .input-block {
      background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);
      border-radius: 16px; padding: 18px 20px;
    }
    .input-label { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .input-label .flag { font-size: 24px; }
    .input-label .code { color: rgba(255,255,255,0.5); font-size: 13px; font-weight: 600; letter-spacing: 1.5px; }
    .input-block input[type="number"] {
      width: 100%; background: transparent; border: none; outline: none;
      color: #fff; font-size: 32px; font-family: 'Space Mono', monospace;
      font-weight: 700; letter-spacing: -1px;
    }
    .swap-wrap { display: flex; justify-content: center; margin: -12px 0; position: relative; z-index: 2; }
    .btn-swap {
      width: 44px; height: 44px; border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: 3px solid #0a0a0a; color: #fff; font-size: 18px;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 20px rgba(102,126,234,0.4);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .btn-swap:hover { transform: rotate(180deg) scale(1.1); }
    .error-msg {
      color: #ff6b6b; font-size: 13px; margin-bottom: 16px;
      padding: 10px 14px; background: rgba(255,100,100,0.08); border-radius: 10px;
    }
    .sync { text-align: center; color: rgba(255,255,255,0.2); font-size: 10px; font-family: 'Space Mono', monospace; margin-top: 16px; }

