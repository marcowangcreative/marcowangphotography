  </div>

  <!-- TRANSLATOR -->

  <div class="card">
    <div class="header">
      <div>
        <h2>Translate</h2>
        <div class="sub">English → Spanish</div>
      </div>
    </div>
    <div class="translate-grid">
      <div class="translate-col">
        <label><span class="flag">🇺🇸</span> EN</label>
        <textarea id="source-text" placeholder="Type English text..." oninput="updateCharCount()"></textarea>
      </div>
      <div class="translate-col">
        <label><span class="flag">🇲🇽</span> ES</label>
        <textarea id="translated-text" class="output" placeholder="Translation appears here..." readonly></textarea>
      </div>
    </div>
    <div class="translate-footer">
      <span class="char-count" id="char-count">0 chars</span>
      <button class="btn-translate" id="btn-translate" onclick="translateText()">Translate</button>
    </div>
  </div>

  <script>
    let rate = null;
    let direction = "usd-to-mxn"; // top=USD, bottom=MXN

    async function fetchRate() {
      document.getElementById("rate-display").textContent = "fetching...";
      document.getElementById("btn-refresh").textContent = "↻";
      document.getElementById("error-box").style.display = "none";

      const attempts = [
        async () => { const r = await fetch("https://open.er-api.com/v6/latest/USD"); const d = await r.json(); return d?.rates?.MXN; },
        async () => { const r = await fetch("https://latest.currency-api.pages.dev/v1/currencies/usd.json"); const d = await r.json(); return d?.usd?.mxn; },
      ];

      let mxnRate = null;
      for (const attempt of attempts) {
        try { const v = await attempt(); if (v) { mxnRate = v; break; } } catch {}
      }

      if (mxnRate) {
        rate = mxnRate;
        document.getElementById("rate-display").textContent = "1 USD = " + rate.toFixed(4) + " MXN";
        document.getElementById("sync-time").textContent = "last sync " + new Date().toLocaleTimeString();
        document.getElementById("error-box").style.display = "none";
        onTopInput();
      } else {
        document.getElementById("rate-display").textContent = "—";
        document.getElementById("error-box").textContent = "Couldn't fetch live rates. Check connection.";
        document.getElementById("error-box").style.display = "block";
      }
      document.getElementById("btn-refresh").textContent = "Refresh";
    }

    function onTopInput() {
      if (!rate) return;
      const val = parseFloat(document.getElementById("top-input").value);
      if (isNaN(val)) { document.getElementById("bottom-input").value = ""; return; }
      if (direction === "usd-to-mxn") {
        document.getElementById("bottom-input").value = (val * rate).toFixed(2);
      } else {
        document.getElementById("bottom-input").value = (val / rate).toFixed(2);
      }
    }

    function onBottomInput() {
      if (!rate) return;
      const val = parseFloat(document.getElementById("bottom-input").value);
      if (isNaN(val)) { document.getElementById("top-input").value = ""; return; }
      if (direction === "usd-to-mxn") {
        document.getElementById("top-input").value = (val / rate).toFixed(2);
      } else {
        document.getElementById("top-input").value = (val * rate).toFixed(2);
      }
    }

    function swapDirection() {
      const topVal = document.getElementById("top-input").value;
      const bottomVal = document.getElementById("bottom-input").value;

      if (direction === "usd-to-mxn") {
        direction = "mxn-to-usd";
        document.getElementById("top-flag").textContent = "🇲🇽";
        document.getElementById("top-code").textContent = "MXN";
        document.getElementById("bottom-flag").textContent = "🇺🇸";
        document.getElementById("bottom-code").textContent = "USD";
      } else {
        direction = "usd-to-mxn";
        document.getElementById("top-flag").textContent = "🇺🇸";
        document.getElementById("top-code").textContent = "USD";
        document.getElementById("bottom-flag").textContent = "🇲🇽";
        document.getElementById("bottom-code").textContent = "MXN";
      }
      document.getElementById("top-input").value = bottomVal;
      document.getElementById("bottom-input").value = topVal;
    }

    // --- TRANSLATE ---
    function updateCharCount() {
      const len = document.getElementById("source-text").value.length;
      document.getElementById("char-count").textContent = len + " chars";
    }

    async function translateText() {
      const text = document.getElementById("source-text").value.trim();
      if (!text) return;

      const btn = document.getElementById("btn-translate");
      const output = document.getElementById("translated-text");
      btn.disabled = true;
      btn.textContent = "Translating...";
      output.value = "";

      try {
        const url = "https://api.mymemory.translated.net/get?q=" +
          encodeURIComponent(text) + "&langpair=en|es";
        const res = await fetch(url);
        const data = await res.json();
        if (data?.responseData?.translatedText) {
          output.value = data.responseData.translatedText;
        } else {
          output.value = "Translation failed. Try shorter text.";
        }
      } catch {
        output.value = "Error — check connection and retry.";
      }

      btn.disabled = false;
      btn.textContent = "Translate";
    }

    // Allow Ctrl+Enter / Cmd+Enter to translate
    document.getElementById("source-text").addEventListener("keydown", (e) => {
      if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) translateText();
    });

    // Init
    fetchRate();
  </script>

</body>
